Options -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# A missing build file (e.g. an old hashed asset removed by a deploy) must be a real 404,
# never the HTML page, or the browser can't run it and the site goes blank.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/ - [R=404,L]

# React Router: send every other non-file request to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Only the content-hashed build files (assets/*.js, *.css) are safe to cache forever
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images, video and fonts keep fixed names (e.g. the logo), so refresh them within a day
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # The HTML page (also served for every app route) must never be reused from a cache
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
